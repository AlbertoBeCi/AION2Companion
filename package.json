{
  "name": "aion2-companion",
  "private": true,
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win portable --x64 --publish never",
    "desktop:test": "npm run build && node desktop/smoke-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tanstack/react-query": "^5.90.2",
    "dexie": "^4.2.1",
    "dexie-react-hooks": "^1.1.7",
    "i18next": "^25.5.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.4",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.1.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^3.2.4",
    "workbox-window": "^7.4.1"
  },
  "main": "desktop/main.cjs",
  "description": "Seguimiento local de AION 2 con un widget de diarias para el escritorio.",
  "build": {
    "appId": "com.aion2companion.desktop",
    "productName": "AION2 Companion",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/main.cjs",
      "desktop/preload.cjs",
      "package.json",
      "!node_modules/**/*",
      "desktop/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signExecutable": false,
      "icon": "desktop/icon.ico"
    },
    "portable": {
      "artifactName": "AION2-Companion-${version}-Windows.exe",
      "useZip": true
    },
    "electronDist": "node_modules/electron/dist"
  }
}
